NODE_ENV=development
APP_MODE=live
DEPLOYMENT_PROVIDER=kubernetes
HOST=127.0.0.1
PORT=3201
PUBLIC_ORIGIN=http://localhost:3201
DATABASE_PATH=./data/orbstack.sqlite
CATALOG_PATH=./config/nonexistent-orbstack-catalog.json
ADMIN_USERNAME=admin
# npm run password；将生成的单引号整行放在这里。
ADMIN_PASSWORD_HASH=''
KUBE_CONTEXT=orbstack
KUBE_NAMESPACES=launchpad-test
KUBE_INSTANCE_ID=launchpad-local
KUBE_IMAGE_PULL_SECRETS=
KUBECTL_PATH=kubectl
IMAGE_ALLOWED_PREFIXES=ghcr.io/ggml-org/,docker.io/vllm/,docker.io/lmsysorg/,docker.io/hongccc/
SKOPEO_PATH=skopeo
SYNC_INTERVAL_MS=10000
