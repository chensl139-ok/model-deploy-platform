# QA 接入草案，地址与目标来自用户提供的接入指南（核对于 2026-10-22）。
# https://acnc6zeentra.feishu.cn/docx/UdbYdGoJ5oLWfwxEUIMcGHtwnph
# 本地联调：复制本文件到项目根目录 .env，填写密码哈希与两个专用管理 Token。
# 切勿将填好凭据的 .env 提交到 Git。此文件不适用于公网生产部署。
NODE_ENV=development
APP_MODE=live
HOST=127.0.0.1
PORT=3100
PUBLIC_ORIGIN=http://localhost:5173
TRUST_PROXY=false
DATABASE_PATH=./data/launchpad-live.sqlite
CATALOG_PATH=./config/catalog.json
ADMIN_USERNAME=admin
# 执行 npm run password，复制其输出的整行替换下面这一行。
ADMIN_PASSWORD_HASH=''
IO_BASE_URL=http://qa-api.sotatts.online/maas/model-serving/inference-orchestrator
IO_MANAGEMENT_TOKEN=
REGISTRY_BASE_URL=https://qa-api.sotatts.online/maas/model-serving/model-image-registry
REGISTRY_TOKEN=
OSS_ALLOWED_PREFIXES=oss://inference-models-aliyun/kserve-models/inference-models/tob/
UPSTREAM_TIMEOUT_MS=45000
SYNC_INTERVAL_MS=10000
# 文档示例目标：cluster=70001，namespace=inference-tob。
# target_id=880e5ca1-6c77-4189-b3ab-616d8c95b09a
# 平台仍会实时查询授权目标，以上注释不会覆盖管理接口返回值。
# 可先验证公开引擎镜像，部署时还需导入 QA 获准仓库。
IMAGE_ALLOWED_PREFIXES=docker.io/vllm/,docker.io/lmsysorg/,docker.io/hongccc/,matrix-registry-vpc.cn-shanghai.cr.aliyuncs.com/inference/,matrix-registry-vpc.cn-shanghai.cr.aliyuncs.com/matrix/tob-inference
# 根据实际仓库写入授权填写；默认不允许复制。
IMAGE_IMPORT_PREFIXES=
IMAGE_SOURCE_HOSTS=github.com,git.sotatts.online
REGISTRY_AUTH_FILE=
SKOPEO_PATH=skopeo
