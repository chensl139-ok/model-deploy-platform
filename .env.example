# 本地不创建 .env 时为 setup 模式，可管理草稿，不模拟部署（仅绑定回环地址）。
# 生产部署：复制为 .env，填写域名、密码哈希与真实平台连接。
NODE_ENV=production
APP_MODE=live
DEPLOYMENT_PROVIDER=registry-io
# 原生 Kubernetes 使用 config/orbstack.env.example 或 README 的接入方式。
# 容器部署时将受限 kubeconfig 放在 config 内，并配置 KUBECONFIG=/app/config/kubeconfig。
KUBE_CONTEXT=
KUBE_NAMESPACES=
KUBE_INSTANCE_ID=launchpad
KUBE_IMAGE_PULL_SECRETS=
DOMAIN=models.example.com
PUBLIC_ORIGIN=https://models.example.com
# 如需额外受信前端来源，逗号分隔；保持为空只允许 PUBLIC_ORIGIN。
ADDITIONAL_ORIGINS=
HOST=0.0.0.0
PORT=3100
TRUST_PROXY=true
DATABASE_PATH=./data/launchpad-live.sqlite
CATALOG_PATH=./config/catalog.json
ADMIN_USERNAME=admin
# npm run password 生成单引号包裹的整行，替换下面这一行。不要填写明文密码。
ADMIN_PASSWORD_HASH=''
SESSION_TTL_HOURS=12
# IO_BASE_URL 不包含 /management/v1；内部路径前缀应保留。
IO_BASE_URL=https://<your-io-host>/maas/model-serving/inference-orchestrator
IO_MANAGEMENT_TOKEN=
# 使用 runtimePackageId 模板或 OSS 权重导入时需要 Registry。
REGISTRY_BASE_URL=https://<your-registry-host>/maas/model-serving/model-image-registry
REGISTRY_TOKEN=
# OSS 引用目录白名单，逗号分隔；为空时真实环境禁止导入。
# 只登记已有文件，不在浏览器保存 OSS AccessKey。
OSS_ALLOWED_PREFIXES=oss://inference-models-aliyun/kserve-models/inference-models/tob/
UPSTREAM_TIMEOUT_MS=45000
SYNC_INTERVAL_MS=10000
# 镜像清单校验来源白名单，仓库前缀边界匹配，不能写 URL。
IMAGE_ALLOWED_PREFIXES=docker.io/vllm/,docker.io/lmsysorg/,docker.io/hongccc/,matrix-registry-vpc.cn-shanghai.cr.aliyuncs.com/inference/,matrix-registry-vpc.cn-shanghai.cr.aliyuncs.com/matrix/tob-inference
# 仓库导入的可写目标前缀；为空时禁止复制。导入会创建唯一 tag，不覆盖原版本。
IMAGE_IMPORT_PREFIXES=
# 源码构建允许的 HTTPS Git 主机；凭据由 Registry CI 管理。
IMAGE_SOURCE_HOSTS=github.com,git.sotatts.online
# 服务器镜像仓库凭据文件。该路径需由容器 node 用户可读，勿把密码放到镜像表单。
# Compose 已只读挂载 ./config；例如 /app/config/registry-auth.json。
REGISTRY_AUTH_FILE=
SKOPEO_PATH=skopeo
IMAGE_INSPECT_TIMEOUT_MS=45000
IMAGE_COPY_TIMEOUT_MS=3600000
